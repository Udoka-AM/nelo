# Never commit real values.
SOLANA_CLUSTER=devnet
HELIUS_API_KEY=
ANCHOR_WALLET=~/.config/solana/id.json

# Privy, for the merchant app's onboarding (apps/merchant).
#
# The app ID and client ID are PUBLIC identifiers — they ship inside the APK and
# every request already carries them. `EXPO_PUBLIC_` is the prefix Expo inlines
# into the client bundle, which is exactly what is meant here.
#
# A Privy APP SECRET is a different thing entirely. It belongs on a server and
# must never appear in this file, in app.json, or anywhere in the bundle.
#
# Leave these empty and the app still runs: onboarding by phone number is simply
# not offered, and Mobile Wallet Adapter carries it on its own.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=
