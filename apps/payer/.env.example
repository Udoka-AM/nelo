# Copy to .env and fill in. Every EXPO_PUBLIC_ value is compiled into the APK
# and readable by anyone holding it: nothing here may be a secret.

# An RPC URL with a quota, e.g. https://devnet.helius-rpc.com/?api-key=<key>.
# Empty: the public devnet endpoint, which rate-limits.
EXPO_PUBLIC_SOLANA_RPC_URL=
# Tried in order when the one above is down, slow or rate-limited, then the
# public endpoint last. Comma-separated.
EXPO_PUBLIC_SOLANA_RPC_FALLBACK_URLS=

# Nelo's relayer, which settles payments this phone received from another
# customer, paying the fees. The same URL and token as the merchant app's.
# See docs-site/operations/relay.mdx. Empty: received payments wait on the
# phone until it is set.
EXPO_PUBLIC_NELO_RELAY_URL=
EXPO_PUBLIC_NELO_RELAY_TOKEN=
