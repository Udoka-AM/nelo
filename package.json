{
  "name": "nelo",
  "private": true,
  "version": "0.1.0",
  "description": "Accept payments on the phone you already own. Settles in local currency. Works offline.",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test && anchor test",
    "program:build": "anchor build",
    "program:test": "anchor test",
    "setup:env": "node --disable-warning=ExperimentalWarning scripts/setup-env.mts",
    "rehearse": "node --disable-warning=ExperimentalWarning --env-file-if-exists=$HOME/.config/nelo/relay.env tools/rehearse/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eas-cli": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.15.0"
}
